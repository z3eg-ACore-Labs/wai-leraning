+#ifndef AC_SPLINE_VALIDATION_H
+#define AC_SPLINE_VALIDATION_H
+#define AC_SPLINE_VALIDATION_API 1
+
+#include "Define.h"
+
+class Unit;
+namespace Movement
+{
+    struct MoveSplineInitArgs;
+    using SplineValidator = bool (*)(Unit *, MoveSplineInitArgs const &);
+
+    // An optional static-module validator. It must not modify the executing movement generator.
+    AC_GAME_API bool RegisterSplineValidator(SplineValidator validator);
+    AC_GAME_API void UnregisterSplineValidator(SplineValidator validator);
+    AC_GAME_API bool ValidateSplineLaunch(Unit *unit, MoveSplineInitArgs const &args);
+} // namespace Movement
+#endif
