diff --git a/src/server/game/Movement/SplineValidation.cpp b/src/server/game/Movement/SplineValidation.cpp
new file mode 100644
index 0000000..04f53cb
--- /dev/null
+++ b/src/server/game/Movement/SplineValidation.cpp
@@ -0,0 +1,30 @@
+/* AzerothCore extension; GNU GPL v2 or later. */
+#include "SplineValidation.h"
+#include <atomic>
+
+namespace Movement
+{
+    namespace
+    {
+        std::atomic<SplineValidator> validator{nullptr};
+    }
+
+    bool RegisterSplineValidator(SplineValidator callback)
+    {
+        if (!callback)
+            return false;
+        SplineValidator expected = nullptr;
+        return validator.compare_exchange_strong(expected, callback) || expected == callback;
+    }
+
+    void UnregisterSplineValidator(SplineValidator callback)
+    {
+        validator.compare_exchange_strong(callback, nullptr);
+    }
+
+    bool ValidateSplineLaunch(Unit *unit, MoveSplineInitArgs const &args)
+    {
+        SplineValidator callback = validator.load();
+        return !callback || callback(unit, args);
+    }
+} // namespace Movement
